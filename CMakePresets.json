{
  "version": 6,

  "configurePresets": [
    {
      "name": "local-debug",
      "displayName": "Local CPU Debug",
      "description": "CPU-only development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/local-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EVENT_VOXEL_ENABLE_CUDA": false,
        "BUILD_TESTING": true
      }
    },

    {
      "name": "local-release",
      "displayName": "Local CPU Release",
      "description": "CPU-only optimized build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/local-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EVENT_VOXEL_ENABLE_CUDA": false,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "sanitizer-debug",
      "displayName": "CPU Sanitizer Debug",
      "description": "CPU address and undefined behavior sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sanitizer-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EVENT_VOXEL_ENABLE_CUDA": false,
        "BUILD_TESTING": true,
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },

    {
      "name": "cuda-local-check",
      "displayName": "Local CUDA Compile Check",
      "description": "Compile CUDA sources locally without requiring a GPU",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cuda-local-check",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EVENT_VOXEL_ENABLE_CUDA": true,
        "BUILD_TESTING": true,

        "CMAKE_CUDA_COMPILER": "$env{HOME}/miniconda3/envs/cuda-dev/bin/nvcc",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-15",
        "CMAKE_CUDA_FLAGS": "-Xcompiler=-B/usr/bin",
        "CUDAToolkit_ROOT": "$env{HOME}/miniconda3/envs/cuda-dev",

        "CMAKE_CUDA_ARCHITECTURES": "75"
      }
    },

    {
      "name": "cuda-release",
      "displayName": "Remote CUDA Release",
      "description": "Release build for a machine with an NVIDIA GPU",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cuda-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EVENT_VOXEL_ENABLE_CUDA": true,
        "BUILD_TESTING": true,

        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "cuda-profile",
      "displayName": "GPU profiling build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cuda-profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "EVENT_VOXEL_ENABLE_CUDA": true,
        "BUILD_TESTING": true,
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O2 -g -lineinfo"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "local-debug",
      "configurePreset": "local-debug"
    },

    {
      "name": "local-release",
      "configurePreset": "local-release"
    },


    {
      "name": "sanitizer-debug",
      "configurePreset": "sanitizer-debug"
    },

    {
      "name": "cuda-local-check",
      "configurePreset": "cuda-local-check"
    },

    {
      "name": "cuda-release",
      "configurePreset": "cuda-release"
    },
    {
      "name": "cuda-profile",
      "configurePreset": "cuda-profile"
    }
  ],

  "testPresets": [
    {
      "name": "local-debug",
      "configurePreset": "local-debug",
      "output": {
        "outputOnFailure": true
      }
    },

    {
      "name": "local-release",
      "configurePreset": "local-release",
      "output": {
        "outputOnFailure": true
      }
    },


    {
      "name": "sanitizer-debug",
      "configurePreset": "sanitizer-debug",
      "output": {
        "outputOnFailure": true
      }
    },

    {
      "name": "cuda-local-check",
      "configurePreset": "cuda-local-check",
      "output": {
        "outputOnFailure": true
      }
    },

    {
      "name": "cuda-release",
      "configurePreset": "cuda-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-profile",
      "configurePreset": "cuda-profile",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
