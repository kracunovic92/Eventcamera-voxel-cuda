{
  "version": 6,
  "configurePresets": [
    {
      "name": "local-debug",
      "displayName": "Local CPU Debug",
      "description": "CPU-only development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/local-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "local-release",
      "displayName": "Local CPU Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/local-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "benchmark-release",
      "displayName": "CPU Release benchmarks",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu-benchmark-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EVENT_VOXEL_BUILD_BENCHMARKS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "sanitizer-debug",
      "displayName": "CPU address and undefined behavior sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sanitizer-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local-debug",
      "configurePreset": "local-debug"
    },
    {
      "name": "local-release",
      "configurePreset": "local-release"
    },
    {
      "name": "benchmark-release",
      "configurePreset": "benchmark-release"
    },
    {
      "name": "sanitizer-debug",
      "configurePreset": "sanitizer-debug"
    }
  ],
  "testPresets": [
    {
      "name": "local-debug",
      "configurePreset": "local-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "local-release",
      "configurePreset": "local-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "benchmark-release",
      "configurePreset": "benchmark-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizer-debug",
      "configurePreset": "sanitizer-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
